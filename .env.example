# Required runtime services. The app fails closed when any required value is missing.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/computequest
SESSION_SIGNING_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional public GA4 Measurement ID (for example, G-XXXXXXXXXX). This is not a secret API key.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Monad Testnet public RPC (chain id 10143). Override with an approved provider if rate limits require it.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_BASE_URL=https://testnet.monadvision.com
CAMPAIGN_ESCROW_ADDRESS=
# Public deployment receipt block used as the lower bound for indexed event recovery.
CAMPAIGN_ESCROW_DEPLOYMENT_BLOCK=
VERIFIER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
# Covers roughly 20 buffered settlement calls at the observed 102 MON-gwei Testnet gas price.
RELAYER_MIN_BALANCE_WEI=500000000000000000

# PostgreSQL seed UUID; an identifier, not a credential or onchain campaign number.
DEMO_CAMPAIGN_ID=00000000-0000-4000-8000-000000000002
# Populate only from the confirmed deployment output. Do not assume it is 1.
DEMO_ONCHAIN_CAMPAIGN_ID=
# 0.001 Testnet MON per verified completion × 20 completions = 0.02 Testnet MON campaign budget.
DEMO_ONCHAIN_REWARD_WEI=1000000000000000
DEMO_QUEST_SECONDS=20
DEMO_MAX_COMPLETIONS=20
# Legacy seeded campaign metadata retained for deployment compatibility; viewers are not asked for it.
DEMO_QUEST_ANSWER="parallel execution"

# Optional second campaign. Populate all five only after its separate onchain campaign is confirmed.
PAYZOLL_CAMPAIGN_ID=
PAYZOLL_ONCHAIN_CAMPAIGN_ID=
PAYZOLL_ONCHAIN_REWARD_WEI=
PAYZOLL_QUEST_SECONDS=
PAYZOLL_MAX_COMPLETIONS=
