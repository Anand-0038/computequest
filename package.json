{
  "name": "computequest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration:postgres": "vitest run src/server/services/postgres.integration.test.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "media:generate:sponsor": "bash scripts/generate-sponsor-creative.sh",
    "media:studio:sponsor": "remotion studio video/index.ts --no-open",
    "media:still:sponsor": "remotion still video/index.ts MonadPromo",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vvv",
    "contracts:preflight:testnet": "tsx scripts/preflight-contract-deployment.ts",
    "contracts:deploy:testnet": "cd contracts && forge script script/DeployComputeQuest.s.sol:DeployComputeQuest --rpc-url $MONAD_RPC_URL --broadcast",
    "contracts:preflight:deployed": "tsx scripts/preflight-deployed-contract.ts",
    "contracts:verify:testnet": "bash contracts/script/verify-testnet.sh",
    "verify": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm contracts:test && corepack pnpm build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/captions": "4.0.518",
    "@remotion/cli": "4.0.518",
    "@remotion/google-fonts": "4.0.518",
    "@remotion/media": "4.0.518",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "remotion": "4.0.518",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.21.0"
}
